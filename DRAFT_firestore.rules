rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // PILLAR 0: DEFAULT DENY CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // PILLAR 3: GLOBAL HELPERS & ID HARDENING
    // ==========================================
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // PILLAR 4: TIERED IDENTITY (ADMIN SUPREMACY)
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "jhansidharmana222@gmail.com" || 
        request.auth.token.email == "chitti.bhargav3@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ==========================================
    // PILLAR 2: VALIDATION BLUEPRINTS
    // ==========================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 64 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['admin', 'user'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'text', 'userId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() <= 10000 &&
             data.userId == request.auth.uid;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidDebate(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userArgument', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 200 &&
             data.userArgument is string && data.userArgument.size() <= 10000 &&
             data.status in ['pending', 'resolved'];
    }

    function isValidSharedTranscript(data) {
      return data.keys().hasAll(['id', 'userId', 'messages', 'createdAt']) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.messages is string &&
             data.messages.size() <= 1048576; // Max 1MB
    }

    function isValidThreatMatrix(data) {
      return data.keys().hasAll(['content', 'timestamp']) &&
             data.content is string && data.content.size() <= 100000;
    }

    function isValidLedgerEntry(data) {
      return data.keys().hasAll(['index', 'timestamp', 'data', 'previousHash', 'hash', 'agentId', 'role']) &&
             data.index is int &&
             data.previousHash is string &&
             data.hash is string &&
             data.agentId is string &&
             data.role is string;
    }

    // ==========================================
    // PILLAR 6: PII ISOLATION & COLLECTION RULES
    // ==========================================

    match /shared_transcripts/{id} {
      allow get: if isValidId(id);
      allow list: if false;
      allow create: if isSignedIn() && isValidSharedTranscript(incoming()) && isValidId(id);
      allow update, delete: if isAdmin();
    }

    match /intelligence/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create: if isSignedIn(); // Agents run on client side sometimes
      allow update, delete: if isAdmin();
    }

    match /explanations/{id} {
      allow get: if isValidId(id);
      allow list: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /config/{id} {
      allow read, write: if isAdmin();
    }

    match /agent_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /tweets/{id} {
      allow get: if isValidId(id);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /responses/{id} {
      allow get: if isValidId(id);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /ledger/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create: if isSignedIn() && isValidLedgerEntry(incoming());
      allow update, delete: if isAdmin();
    }

    match /chronicles/{id} {
      allow get: if isSignedIn() && isValidId(id);
      allow list: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /debates/{id} {
      allow get: if isValidId(id);
      allow list: if true; 
      allow create: if isSignedIn() &&
                      isValidDebate(incoming()) &&
                      incoming().createdAt == request.time &&
                      isValidId(id);
                      
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['aiResponse', 'status']) &&
         incoming().status == 'resolved') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /threat_matrices/{id} {
      allow get: if isValidId(id);
      allow list: if true;
      allow create: if isSignedIn() && isValidThreatMatrix(incoming());
      allow update, delete: if isAdmin();
    }

    match /payments/{id} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; 
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      
      allow update: if (isOwner(uid) && 
                      isValidUser(incoming()) && 
                      incoming().role == existing().role &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['explanationViewCount'])) ||
                    isAdmin();
      
      allow create: if isOwner(uid) && 
                      isValidUser(incoming()) && 
                      incoming().role == 'user';
    }

    match /subscriptions/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /conversations/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidConversation(incoming()) && isValidId(id);
      
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'updatedAt', 'title'])) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentOwned() {
          let parentDoc = getAfter(/databases/$(database)/documents/conversations/$(id));
          return parentDoc != null && parentDoc.data.userId == request.auth.uid;
        }

        function parentExists() {
          return existsAfter(/databases/$(database)/documents/conversations/$(id));
        }

        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        
        allow create: if isSignedIn() && 
                        isValidMessage(incoming()) && 
                        parentExists() &&
                        parentOwned() && 
                        isValidId(messageId) &&
                        incoming().createdAt == request.time;
        
        allow update, delete: if isAdmin(); 
      }
    }
  }
}
