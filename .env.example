# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# If 'GEMINI_API_KEY' is a reserved name in your UI, use 'USER_GEMINI_KEY' instead.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
USER_GEMINI_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twitter (X) API Credentials
# Used for the agent to post to a specific Twitter account.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Twitter (X) OAuth 2.0 (Optional, for web-based connection)
# 1. Create a Web App at https://developer.twitter.com/en/portal/dashboard
# 2. Set Redirect URI to: ${APP_URL}/api/auth/twitter/callback
# 3. Add Client ID and Secret to Secrets panel
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Razorpay Payment Gateway
# 1. Get keys from https://dashboard.razorpay.com/app/keys
# 2. Add to Secrets panel
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Firebase Server Configuration
FIREBASE_DATABASE_ID= # If different from VITE_FIREBASE_DATABASE_ID (usually same)

# Aitihya Chain Security
AITIHYA_SIGNING_SECRET= # Secret key for signing the truth ledger. PROTECT THIS.

# Firebase Service Account (Optional, for server-side admin access)
FIREBASE_SERVICE_ACCOUNT=

# Vercel Cron Secret
# This should match the CRON_SECRET environment variable automatically provided by Vercel
# or manually set to secure the /api/cron endpoints.
CRON_SECRET=
