# ============================================================
# Arthashastra AI — environment variables
# Copy to .env for local use. On Vercel: Project → Settings → Environment Variables.
# NEVER commit real values. Only VITE_* values reach the browser (they are public).
# ============================================================

# --- AI (server only, required) ---
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models to try in order (comma separated)
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# --- Firebase (browser, public config from Firebase console → Project settings → Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave empty for the "(default)" database
VITE_FIREBASE_DATABASE_ID=

# --- Firebase Admin (server only, required on Vercel) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
# Usually not needed (taken from the VITE_ values above)
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_ID=

# --- Admins (server) ---
# Comma separated Google emails with admin rights in the app (run agents, see logs)
ADMIN_EMAILS=

# --- Payments: Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<your-domain>/api/payments/webhook  (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Optional: price in paise (default 3400 = ₹34) and days per payment (default 30)
# SUBSCRIPTION_PRICE_PAISE=3400
# SUBSCRIPTION_DAYS=30
VITE_PRICE_LABEL=₹34 for 30 days

# --- Ledger signing (server) ---
# Any long random string (e.g. `openssl rand -hex 32`). Keep it secret and never change it.
AITIHYA_SIGNING_SECRET=

# --- Scheduled agents ---
# Vercel sends this automatically to cron jobs when CRON_SECRET is set. Use a long random string.
CRON_SECRET=
# Only for always-on servers (Cloud Run, VPS): run a cycle every N minutes. Leave 0 on Vercel.
AGENT_SCHEDULER_MINUTES=0

# --- Daily AI limits per user (optional) ---
# DAILY_LIMIT_ANONYMOUS=5
# DAILY_LIMIT_FREE=20
# DAILY_LIMIT_SUBSCRIBER=200
# FREE_EXPLANATIONS=3

# --- Legal page details (public, shown on Terms/Privacy) ---
VITE_LEGAL_ENTITY=
VITE_LEGAL_ADDRESS=
VITE_CONTACT_EMAIL=
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=
VITE_GOVERNING_LAW=the laws of India
