rules_version = '2';

// Arthashastra AI — Firestore security rules.
// Principle: the server (Firebase Admin SDK) writes everything public or
// money-related. Admin SDK writes bypass these rules. Browsers may only touch
// their own private data, plus public debates with strict validation.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isRealUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Admins: custom claim `admin: true` (set with scripts/set-admin.ts) or the owner's verified email.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email', '') == 'chitti.bhargav3@gmail.com' &&
         request.auth.token.get('email_verified', false) == true)
      );
    }
    function data() { return request.resource.data; }
    function onlyKeys(allowed) { return data().keys().hasOnly(allowed); }
    function changedOnly(allowed) { return data().diff(resource.data).affectedKeys().hasOnly(allowed); }
    function str(v, max) { return v is string && v.size() <= max; }
    function validId(id) { return id is string && id.size() <= 128 && id.matches('^[A-Za-z0-9_-]+$'); }

    // ---------- default: deny ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- public, server-written ----------
    match /intelligence/{id} {
      allow read: if true;
    }
    match /chronicles/{id} {
      allow read: if true; // the daily Gazette is public so share links work
    }
    match /threat_matrices/{id} {
      allow read: if signedIn();
    }
    match /ledger/{id} {
      allow read: if signedIn();
    }
    match /agent_block_ledger/{id} {
      allow read: if signedIn();
    }
    // explanations are served through the server paywall (/api/explanations/:id) only.

    // ---------- admin-only, server-written ----------
    match /agent_logs/{id} {
      allow read: if isAdmin();
    }

    // ---------- the user's own account (server-written) ----------
    match /users/{uid} {
      allow get: if isUser(uid) || isAdmin();
    }
    match /subscriptions/{uid} {
      allow get: if isUser(uid) || isAdmin();
      allow list: if isAdmin();
    }
    match /payments/{id} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    match /usage/{id} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- private chats ----------
    match /conversations/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if validId(id) && signedIn() &&
        onlyKeys(['id', 'userId', 'title', 'lastMessageAt', 'updatedAt', 'createdAt']) &&
        data().userId == request.auth.uid && data().id == id && str(data().title, 200);
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        changedOnly(['title', 'lastMessageAt', 'updatedAt']) && str(data().title, 200);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      function ownsConversation() {
        return signedIn() &&
          getAfter(/databases/$(database)/documents/conversations/$(id)).data.userId == request.auth.uid;
      }

      match /messages/{msgId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/conversations/$(id)).data.userId == request.auth.uid || isAdmin());
        allow create: if ownsConversation() &&
          onlyKeys(['id', 'role', 'text', 'userId', 'index', 'hash', 'previousHash', 'timestamp', 'createdAt']) &&
          data().userId == request.auth.uid &&
          data().role in ['user', 'model'] &&
          str(data().text, 100000);
        // Messages are never edited, but the owner may delete them (right to erasure / archiving).
        allow delete: if signedIn() &&
          get(/databases/$(database)/documents/conversations/$(id)).data.userId == request.auth.uid;
      }
    }

    // Public share links. Created by the server from stored messages (POST /api/share),
    // so nobody can publish forged AI answers. The owner may delete their link.
    match /shared_transcripts/{id} {
      allow read: if true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Personal day-by-day memory blocks. Doc id = "<uid>_<YYYY-MM-DD>".
    match /temporal_blocks/{id} {
      allow get, delete: if signedIn() && id.matches(request.auth.uid + '_.*');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*') &&
        data().userId == request.auth.uid;
    }

    // Personal cold storage of old conversations.
    match /cold_archives/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && data().userId == request.auth.uid;
    }

    // Personal audit trail of archive actions.
    match /audit_log/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && data().userId == request.auth.uid &&
        onlyKeys(['userId', 'action', 'details', 'timestamp']) && str(data().action, 100);
    }

    // ---------- the Arena (public debates) ----------
    match /debates/{id} {
      allow read: if signedIn();
      allow create: if validId(id) && isRealUser() &&
        onlyKeys(['id', 'userId', 'userName', 'userArgument', 'createdAt', 'status', 'likesCount']) &&
        data().id == id &&
        data().userId == request.auth.uid &&
        str(data().userName, 100) &&
        str(data().userArgument, 20000) && data().userArgument.size() > 0 &&
        data().status == 'pending' &&
        data().get('likesCount', 0) == 0 &&
        data().createdAt == request.time;
      // A like = +1 on likesCount together with creating likes/{uid} (one per user).
      allow update: if isRealUser() && changedOnly(['likesCount']) &&
        data().likesCount == resource.data.get('likesCount', 0) + 1 &&
        !exists(/databases/$(database)/documents/debates/$(id)/likes/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/debates/$(id)/likes/$(request.auth.uid));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isUser(uid) && isRealUser() && onlyKeys(['createdAt']) && data().createdAt == request.time;
      }

      // Users post their own messages; AI ("model") replies are written by the server only.
      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if validId(msgId) && isRealUser() &&
          onlyKeys(['id', 'userId', 'userName', 'role', 'text', 'createdAt']) &&
          data().id == msgId &&
          data().userId == request.auth.uid &&
          data().role == 'user' &&
          str(data().text, 2000) && data().text.size() > 0 &&
          data().createdAt == request.time;
        allow delete: if isAdmin();
      }
    }
  }
}
