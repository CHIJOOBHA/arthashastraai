rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email == 'jhansidharmana222@gmail.com') ||
        (request.auth.token.email == 'chitti.bhargav3@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isServerTimestamp(ts) { return ts == request.time; }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.role == 'user' || (data.role == 'admin' && (data.email == 'jhansidharmana222@gmail.com' || data.email == 'chitti.bhargav3@gmail.com')));
    }

    function isValidDebate(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userArgument', 'createdAt', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.userArgument is string &&
             data.status in ['pending', 'resolved'] &&
             data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'text', 'userId', 'hash', 'index']) &&
             data.id is string && data.id.size() <= 128 &&
             data.role is string &&
             data.text is string && data.text.size() <= 100000 &&
             data.userId == request.auth.uid &&
             data.hash is string && data.hash.size() == 64 &&
             data.index is int;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidThreatMatrix(data) {
      return data.keys().hasAll(['content', 'timestamp', 'agentReportsUsed']) &&
             data.keys().size() == 3 &&
             data.content is string && data.content.size() <= 100000 &&
             data.timestamp == request.time &&
             data.agentReportsUsed is bool;
    }

    // --- MATCH BLOCKS ---
    
    match /_health_/{id} {
      allow read, write: if true;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // PUBLIC READ-ONLY COLLECTIONS
    match /intelligence/{id} {
      allow read: if true;
      allow write: if true; // Allow write for Admin as well as server Client SDK fallback seeding
    }

    match /tweets/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /responses/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /chronicles/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /threat_matrices/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidThreatMatrix(incoming());
      allow update, delete: if false;
    }

    match /ledger/{id} {
      allow read: if isSignedIn();
      allow write: if true; // Allow write for Client SDK ledger logs
    }

    match /agent_block_ledger/{id} {
      allow read: if isSignedIn();
      allow write: if true; // Allow write for Client SDK agent ledger logs
    }

    match /shared_transcripts/{id} {
      allow read: if true; // Publicly shared
      allow write: if false;
    }

    // USER-SPECIFIC COLLECTIONS
    match /users/{uid} {
      // Split PII: email is sensitive.
      // Blanket reads forbidden.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false; 
      
      allow create: if isOwner(uid) && isValidUser(incoming());
      allow update: if (isOwner(uid) || isAdmin()) && (
        // Users can't change their own role
        (incoming().diff(existing()).affectedKeys().hasOnly(['email', 'explanationViewCount', 'isSubscribed']) && incoming().role == existing().role) ||
        isAdmin()
      );
    }

    match /subscriptions/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false; // System managed
    }

    match /payments/{id} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // System managed
    }

    match /conversations/{id} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isSignedIn() && isValidConversation(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['id', 'userId', 'title', 'lastMessageAt', 'updatedAt']) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    match /conversations/{id}/messages/{msgId} {
      allow read: if (exists(/databases/$(database)/documents/conversations/$(id)) && isOwner(get(/databases/$(database)/documents/conversations/$(id)).data.userId)) || isAdmin();
      allow create: if isSignedIn() && 
                    (!exists(/databases/$(database)/documents/conversations/$(id)) || get(/databases/$(database)/documents/conversations/$(id)).data.userId == request.auth.uid) &&
                    isValidMessage(incoming());
      allow update, delete: if false; // Messages are immutable blocks
    }

    match /debates/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDebate(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Users can only increment likesCount
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && 
         incoming().userId == existing().userId) // In a real app, likes would be in a subcollection
      );
    }

    match /debates/{id}/chat/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    incoming().keys().hasAll(['id', 'userId', 'role', 'text', 'createdAt']) &&
                    incoming().id == msgId &&
                    incoming().userId == request.auth.uid &&
                    incoming().role in ['user', 'model'] &&
                    incoming().text is string &&
                    incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // SYSTEM COLLECTIONS
    match /agent_logs/{id} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow write: if true; // Allowed for Server Client SDK logging fallback
    }

    match /audit_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /explanations/{id} {
      allow read: if isSignedIn();
      allow write: if true; // Allowed for Server Client SDK explanation generation
    }

    match /cold_archives/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /temporal_blocks/{id} {
      allow read, create, update, delete: if isSignedIn() && id.startsWith(request.auth.uid + "_");
    }

    match /config/{id} {
      allow read, write: if false; // Highly sensitive
    }
  }
}
